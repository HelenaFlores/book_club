{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "club",
    "user",
    "review",
    "assessment",
    "readPages",
    "created"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "club": {
      "type": "integer"
    },
    "user": {
      "type": "object",
      "required": [
        "id",
        "username"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "string"
    },
    "assessment": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "readPages": {
      "type": "integer",
      "minimum": 0
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}